    },
    {
      "sha": "0a602c5da5b74d762806ade13635ed81187588d9",
      "title": "reconstruct: adaptar protocolo al cliente congelado",
      "evidence": "Entradas exactas de before-low-latency.zip. Estado previo a la baja latencia.\nEste respaldo no contiene todos los archivos necesarios para ejecutar el cliente."
    },
    {
      "sha": "b578a72a6a2e990cd55df27fbfad91b3dc906d78",
      "title": "reconstruct: recuperar primer ajuste de latencia local",
      "evidence": "Tres archivos exactos de before-render-optimization.zip; el resto conserva el\nrespaldo anterior. Es una reconstruccion parcial, no un snapshot integral probado."
    },
    {
      "sha": "38025eef6247af978795b949416d98c0b570c793",
      "title": "reconstruct: recuperar servidor previo al combate autoritativo",
      "evidence": "Fuentes y configuracion exactas de before-authoritative-combat.zip. Agrupa\najustes posteriores de red y controles sin inventar snapshots intermedios."
    },
    {
      "sha": "8353417bdc539743b2d0d7772090b92dc70c537f",
      "title": "reconstruct: consolidar copia portable y cliente local optimizado",
      "evidence": "Archivos actuales: aislamiento de preferencias, lanzadores, congelacion,\noverlay local, renderizado, detencion del movimiento y backend FFM.\nSin respaldos completos para separar con exactitud cada correccion del cliente."
    },
    {
      "sha": "8a074ae2f03bfdea82fc2de0555dfd844cf5e205",
      "title": "reconstruct: implementar combate autoritativo y regresiones",
      "evidence": "Diferencia entre el respaldo previo al combate y las fuentes actuales.\nIncluye controlador vanilla, cubos, dano, proyectiles, bombas y pruebas.\nParidad incompleta y comprobacion visual pendiente; ver COMBATE_VANILLA.md."
    },
    {
      "sha": "ac338fa46b55c01308f5e47eceb2ca8c74c51bd8",
      "title": "reconstruct: documentar hosting Windows y evidencia de validacion",
      "evidence": "Documentacion y herramientas actuales. Las notas describen pruebas historicas;\nlos logs, dumps, recursos, perfiles y binarios referenciados no se distribuyen."
    }
